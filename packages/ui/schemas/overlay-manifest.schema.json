{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimatum-project.org/schemas/overlay-manifest-v1.schema.json",
  "title": "Ultimatum overlay manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "overlaysVersion", "gameId", "portId", "overlays"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "overlaysVersion": { "type": "integer", "minimum": 1 },
    "gameId": { "$ref": "#/$defs/id" },
    "portId": { "$ref": "#/$defs/id" },
    "overlays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "surface", "presentation", "modality", "worldContext", "gameplayPolicy", "dismissPolicy", "hosts"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "owner": { "enum": ["platform", "port"] },
          "surface": { "enum": ["dialog", "drawer"] },
          "presentation": { "enum": ["full-screen", "partial-overlay", "edge-drawer", "adaptive"] },
          "modality": { "enum": ["modal", "nonmodal"] },
          "worldContext": { "enum": ["hidden", "visible", "adaptive"] },
          "gameplayPolicy": { "enum": ["unavailable", "continues", "input-captured", "port-paused"] },
          "dismissPolicy": { "enum": ["dismissible", "conditional", "required"] },
          "hosts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["web", "native"] } }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 }
  }
}
