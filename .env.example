# Copy this file to .env.local and fill in values for your own projects.
# .env.local is ignored by Git. Process environment variables override it.

# Apple development/signing configuration. The Team ID and bundle ID are
# identifiers, not signing credentials; certificates and profiles stay in
# Xcode's Keychain/provisioning storage.
ZU4_IOS_TEAM=
ZU4_IOS_BUNDLE_ID=org.example.ultimatum.u4
ZU4_IOS_VERSION=1.0
ZU4_IOS_BUILD_NUMBER=1

# Low-privilege browser/mobile client configuration. Use Supabase publishable
# keys (sb_publishable_...), never secret or service_role keys.
ULTIMATUM_SUPABASE_PUBLIC_URL=
ULTIMATUM_SUPABASE_PUBLIC_KEY=
ULTIMATUM_SUPABASE_PUBLIC_PROJECT=ultimatum-prod

ULTIMATUM_SUPABASE_TEST_URL=
ULTIMATUM_SUPABASE_TEST_KEY=
ULTIMATUM_SUPABASE_TEST_PROJECT=ultimatum-test

# Optional local value used only to render a one-time administrator bootstrap
# statement. It is never bundled into either client.
ULTIMATUM_ADMIN_EMAIL=
