/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
/
  Cache-Control: no-cache
/play/
  Cache-Control: no-cache
/play/engine/assets.json
  Cache-Control: no-cache
/play/engine/ultimatum-engine.js
  Cache-Control: no-cache
/play/engine/ultimatum-engine.wasm
  Cache-Control: no-cache
/play/engine/assets-*
  Cache-Control: public, max-age=31536000, immutable
/play/engine/engine-*
  Cache-Control: public, max-age=31536000, immutable
