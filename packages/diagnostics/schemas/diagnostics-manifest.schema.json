{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimatum-project.org/schemas/diagnostics-manifest-v1.schema.json",
  "title": "Ultimatum port diagnostics manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "diagnosticsVersion", "gameId", "portId", "events"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "diagnosticsVersion": { "type": "integer", "minimum": 1 },
    "gameId": { "$ref": "#/$defs/id" },
    "portId": { "$ref": "#/$defs/id" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "component", "severity", "detailKeys"],
        "properties": {
          "code": { "$ref": "#/$defs/code" },
          "component": { "$ref": "#/$defs/id" },
          "severity": { "enum": ["debug", "info", "warning", "error"] },
          "detailKeys": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "code": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$", "maxLength": 120 }
  }
}
