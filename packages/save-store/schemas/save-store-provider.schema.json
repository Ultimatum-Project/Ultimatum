{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimatum-project.org/schemas/save-store-provider-v1.schema.json",
  "title": "Ultimatum save-store provider descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "gameId", "providers", "portableFormats", "semantics"],
  "properties": {
    "contractVersion": { "const": 1 },
    "gameId": { "$ref": "#/$defs/id" },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "host", "physicalModel"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "host": { "enum": ["web", "native"] },
          "physicalModel": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    },
    "portableFormats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "version", "extension"],
        "properties": {
          "format": { "type": "string", "minLength": 1, "maxLength": 80 },
          "version": { "type": "integer", "minimum": 1 },
          "extension": { "type": "string", "pattern": "^\\.[a-z0-9]+$" }
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentAndPrevious", "compareAndSwap", "atomicPublication", "quarantineExport", "metadataOnlyTransactions"],
      "properties": {
        "currentAndPrevious": { "const": true },
        "compareAndSwap": { "const": true },
        "atomicPublication": { "const": true },
        "quarantineExport": { "const": true },
        "metadataOnlyTransactions": { "const": true }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 }
  }
}
